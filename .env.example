VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (Vercel API routes — NO VITE_ prefix, never bundled to the client)
# DeepL translation key. Free-tier keys end in ":fx".
DEEPL_API_KEY=your_deepl_api_key

# SMTP Configuration (Gmail App Password)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_TO=nkhb316@gmail.com

# Cloudflare R2 (file uploads). R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
# Public base URL of the bucket (r2.dev URL or custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
